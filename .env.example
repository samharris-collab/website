# Copy to .env.local for local development, and set the same variables in the
# Vercel project. Every one of these is optional: without them the site builds
# and runs, and the features that need them degrade honestly rather than
# pretending to work.

# --- Canonical origin -------------------------------------------------------
# Used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
# Defaults to https://www.digitalnetworkingagency.com.
NEXT_PUBLIC_SITE_URL=https://www.digitalnetworkingagency.com

# --- Contact form delivery (Resend) -----------------------------------------
# Without RESEND_API_KEY the contact endpoint returns 503 and the form offers a
# prefilled mailto instead of showing a success screen for a message nobody got.
# REQUIRED before launch.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Falls back to Resend's
# onboarding sender, which is fine for testing and not for production.
RESEND_FROM="DNA PR <hello@digitalnetworkingagency.com>"

# --- Contact form rate limiting (Upstash Redis) -----------------------------
# 5 submissions per IP per hour. Without these the limiter falls back to an
# in-process map, which does not hold across serverless instances.
# Strongly recommended before launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
# Both must be set for the widget to render and be verified. With neither, the
# honeypot and rate limiter still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional Slack relay ---------------------------------------------------
# Posts each enquiry to a channel. No-ops when unset.
SLACK_WEBHOOK_URL=

# --- Error tracking (Sentry) ------------------------------------------------
# SENTRY_DSN covers server and edge errors. Set NEXT_PUBLIC_SENTRY_DSN as well to
# report browser errors — the browser SDK is imported lazily, so leaving it unset
# costs the page nothing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Product analytics (PostHog) --------------------------------------------
# Also lazily imported. Without a key, nothing loads and `track()` is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
